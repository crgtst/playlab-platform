  "uid": "playlab-load",
  "title": "k6 and JMeter",
  "tags": ["playlab", "load"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "editable": false,
  "links": [
    {
      "title": "PlayLab API",
      "type": "link",
      "url": "/d/playlab-api",
      "icon": "dashboard"
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "load",
        "label": "Load",
        "type": "custom",
        "query": "products,orders,soak,overload",
        "current": {
          "text": "products",
          "value": "products"
        },
        "options": [
          {
            "text": "products",
            "value": "products",
            "selected": true
          },
          {
            "text": "orders",
            "value": "orders",
            "selected": false
          },
          {
            "text": "soak",
            "value": "soak",
            "selected": false
          },
          {
            "text": "overload",
            "value": "overload",
            "selected": false
          }
        ],
        "hide": 0
      },
      {
        "name": "request",
        "label": "Request",
        "type": "custom",
        "query": "GET /products.* : GET /products.*,POST /orders : POST /orders,POST /cart/items : POST /cart/items,POST /auth/login : POST /auth/login",
        "current": {
          "text": "GET /products.*",
          "value": "GET /products.*"
        },
        "options": [
          {
            "text": "GET /products.*",
            "value": "GET /products.*",
            "selected": true
          },
          {
            "text": "POST /orders",
            "value": "POST /orders",
            "selected": false
          },
          {
            "text": "POST /cart/items",
            "value": "POST /cart/items",
            "selected": false
          },
          {
            "text": "POST /auth/login",
            "value": "POST /auth/login",
            "selected": false
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**k6 and JMeter on one model.** Both tools run `tests/shared/load-model.json` against the perf profile and send their results here (`PROMETHEUS_RW=1 tests/k6/run.sh products`, `PROMETHEUS_RW=1 tests/jmeter/run.sh products`). Pick the load and the request above; blue is k6, orange is JMeter, one line for each run. Widen the time range to see both. Latency is measured by each tool at its own end of the connection, so a gap between the two is partly the tool: a JMeter thread costs more than a k6 VU. The API's own view of the same minutes is the **PlayLab API** dashboard."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency",
      "description": "The 95th percentile of each 5-second window, as each tool sees it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^k6.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^JMeter.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (testid) (k6_http_req_duration_p95{tool=\"k6\", load=\"$load\", name=~\"$request\", setup!=\"true\"})",
          "legendFormat": "k6 {{testid}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (testid) (jmeter_http_req_duration_p95{tool=\"jmeter\", load=\"$load\", name=~\"$request\"})",
          "legendFormat": "JMeter {{testid}}"
        }
      ]
    },
