      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (testid) (k6_http_req_failed_rate{tool=\"k6\", load=\"$load\", name=~\"$request\", setup!=\"true\"})",
          "legendFormat": "k6 {{testid}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (testid) (rate(jmeter_http_req_failed_total{tool=\"jmeter\", load=\"$load\", name=~\"$request\"}[30s])) / sum by (testid) (rate(jmeter_http_reqs_total{tool=\"jmeter\", load=\"$load\", name=~\"$request\"}[30s]))",
          "legendFormat": "JMeter {{testid}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "k6 runs",
      "description": "One row for each k6 run in the time range. \"p95 mean\" is the mean of the 5-second p95s; \"p95 worst\" is the highest one.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
