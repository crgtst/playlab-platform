            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Run"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 215
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Run",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "testid": "Run",
              "Value #A": "p95 mean",
              "Value #B": "p95 worst",
              "Value #C": "Requests",
              "Value #D": "Errors"
            },
            "indexByName": {
              "testid": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (testid) (avg_over_time(k6_http_req_duration_p95{tool=\"k6\", load=\"$load\", name=~\"$request\", setup!=\"true\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (testid) (max_over_time(k6_http_req_duration_p95{tool=\"k6\", load=\"$load\", name=~\"$request\", setup!=\"true\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (testid) (increase(k6_http_reqs_total{tool=\"k6\", load=\"$load\", name=~\"$request\", setup!=\"true\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (testid) (avg_over_time(k6_http_req_failed_rate{tool=\"k6\", load=\"$load\", name=~\"$request\", setup!=\"true\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
