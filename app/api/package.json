{
  "name": "playlab-shop-api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "vitest run --project integration",
    "export:schemas": "tsx scripts/export-schemas.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "swagger-ui-express": "5.0.1",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pact-foundation/pact": "17.1.4",
    "@types/bcryptjs": "3.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
