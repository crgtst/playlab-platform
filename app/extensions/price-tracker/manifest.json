{
  "manifest_version": 3,
  "name": "PlayLab Price Tracker",
  "version": "1.0.0",
  "description": "Practice extension: reads PlayLab Shop product prices and remembers the lowest one seen.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PlayLab Price Tracker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
