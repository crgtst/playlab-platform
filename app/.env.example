# Copy to .env (next to docker-compose.yml) to override defaults.

# Test hooks under /test/*. Set to false to check they are switched off (every /test/* returns 404).
TEST_HOOKS=true

# Requests per minute per user (or per IP for guests). Raise it for big parallel suites.
RATE_LIMIT_PER_MIN=100

# How long the timeout test card (4000 0000 0000 0119) hangs before the API returns 504.
PAYMENT_TIMEOUT_MS=5000

# Where the browser loads the hosted payment iframe from, and which shop origins may embed it.
# Both follow API_PORT and WEB_PORT by default; set them only to point somewhere else.
# PAYMENT_FRAME_URL=http://localhost:3000/pay/frame
# SHOP_ORIGINS=http://localhost:5173

JWT_SECRET=playlab-dev-secret-not-for-production

# Host ports
WEB_PORT=5173
API_PORT=3000
DB_PORT=5432

# Base URL used in links inside test-mailbox emails. Follows WEB_PORT by default.
# PUBLIC_WEB_URL=http://localhost:5173
