{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderRequest",
  "type": "object",
  "description": "Send exactly one of `payment` or `paymentIntentId`.",
  "required": [
    "shipping",
    "deliveryDate"
  ],
  "properties": {
    "shipping": {
      "$ref": "ShippingAddress.json"
    },
    "deliveryDate": {
      "type": "string",
      "format": "date",
      "description": "Between tomorrow and 30 days from today"
    },
    "instructions": {
      "type": "string",
      "maxLength": 200
    },
    "acceptPriceChanges": {
      "type": "boolean",
      "default": false
    },
    "paymentIntentId": {
      "type": "string",
      "format": "uuid"
    },
    "payment": {
      "type": "object",
      "required": [
        "cardNumber",
        "expiry",
        "cvc",
        "nameOnCard"
      ],
      "properties": {
        "cardNumber": {
          "type": "string",
          "examples": [
            "4242 4242 4242 4242"
          ]
        },
        "expiry": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])/\\d{2}$",
          "examples": [
            "12/30"
          ]
        },
        "cvc": {
          "type": "string",
          "examples": [
            "123"
          ]
        },
        "nameOnCard": {
          "type": "string"
        }
      }
    }
  }
}
