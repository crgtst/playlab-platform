{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoginRequest",
  "type": "object",
  "required": [
    "email",
    "password"
  ],
  "properties": {
    "email": {
      "type": "string",
      "examples": [
        "customer@playlab.test"
      ]
    },
    "password": {
      "type": "string",
      "examples": [
        "Password123!"
      ]
    }
  }
}
