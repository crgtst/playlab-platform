{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wishlist",
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "position",
          "addedAt",
          "product"
        ],
        "properties": {
          "position": {
            "type": "integer"
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          },
          "product": {
            "$ref": "Product.json"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        }
      }
    }
  }
}
