{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Store",
  "type": "object",
  "required": [
    "id",
    "name",
    "address",
    "city",
    "lat",
    "lng",
    "hours"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "hours": {
      "type": "string"
    }
  }
}
