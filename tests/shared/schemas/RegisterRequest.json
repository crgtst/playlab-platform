{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RegisterRequest",
  "type": "object",
  "required": [
    "name",
    "email",
    "password"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "examples": [
        "Aoife Ní Bhriain"
      ]
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    }
  }
}
