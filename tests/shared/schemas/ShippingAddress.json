{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShippingAddress",
  "type": "object",
  "required": [
    "fullName",
    "line1",
    "city",
    "postcode"
  ],
  "properties": {
    "fullName": {
      "type": "string",
      "maxLength": 500
    },
    "line1": {
      "type": "string",
      "maxLength": 200
    },
    "line2": {
      "type": "string",
      "maxLength": 200
    },
    "city": {
      "type": "string",
      "maxLength": 100
    },
    "county": {
      "type": "string",
      "maxLength": 100
    },
    "postcode": {
      "type": "string",
      "maxLength": 20
    },
    "country": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2,
      "default": "IE"
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    }
  }
}
