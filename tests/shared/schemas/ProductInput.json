{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductInput",
  "type": "object",
  "required": [
    "sku",
    "name",
    "category",
    "priceCents",
    "stock"
  ],
  "properties": {
    "sku": {
      "type": "string",
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "category": {
      "type": "string",
      "description": "Category slug"
    },
    "priceCents": {
      "type": "integer",
      "minimum": 0
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "imageUrl": {
      "type": "string"
    }
  }
}
