{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "type": "object",
  "required": [
    "id",
    "email",
    "name",
    "role",
    "emailVerified",
    "avatarUrl",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "name": {
      "type": "string",
      "maxLength": 500
    },
    "role": {
      "$ref": "Role.json"
    },
    "emailVerified": {
      "type": "boolean"
    },
    "avatarUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
