{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review",
  "type": "object",
  "required": [
    "id",
    "productId",
    "rating",
    "title",
    "body",
    "author",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "productId": {
      "type": "integer"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "author": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
