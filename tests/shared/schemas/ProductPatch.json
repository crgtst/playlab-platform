{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductPatch",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "sku": {
      "type": "string",
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "category": {
      "type": "string"
    },
    "priceCents": {
      "type": "integer",
      "minimum": 0
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "imageUrl": {
      "type": "string"
    }
  }
}
