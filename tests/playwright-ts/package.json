{
  "name": "playlab-playwright-ts",
  "version": "1.0.0",
  "private": true,
  "description": "The canonical Playwright suite for PlayLab: every AC, every browser project.",
  "scripts": {
    "test": "playwright test",
    "test:exclusive": "playwright test --project=exclusive --no-deps",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
