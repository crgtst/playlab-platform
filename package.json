{
  "name": "playlab-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Repo-wide tooling: ESLint, Prettier, lint-staged and the pre-commit hook. App dependencies live in app/api and app/web.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "traceability": "node tools/traceability/trace.mjs",
    "traceability:check": "node tools/traceability/trace.mjs --check",
    "traceability:gate2": "node tools/traceability/trace.mjs --gate2",
    "test:tools": "node --test tools/traceability/trace.test.mjs",
    "lint:openapi": "spectral lint app/api/openapi/openapi.yaml --fail-severity=error"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stoplight/spectral-cli": "6.17.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,css,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
